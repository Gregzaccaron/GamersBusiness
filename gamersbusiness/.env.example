# Copy to .env and replace every CHANGE_ME value before starting Compose.
# Never commit .env or put real credentials in this template.

POSTGRES_DB=gamersbusiness
POSTGRES_USER=CHANGE_ME_local_db_user
POSTGRES_PASSWORD=CHANGE_ME_local_db_password

# Use a long random value; do not reuse a production secret.
JWT_SECRET=CHANGE_ME_generate_a_long_random_local_jwt_secret

# Disabled by default. To bootstrap a local ADMIN, set true and provide all fields.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME_admin_username
BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME_admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password
